import turtle
import random

# Setup the screen 
screen = turtle.Screen()
screen.colormode(1.0)
screen.bgcolor("#111111")
screen.tracer(0)  # for the instant showing or better performance // with animation it would be (1)

t = turtle.Turtle()
t.hideturtle()
t.speed(0)

# my parameter
rows, cols = 20, 15
size, spacing = 15, 5
start_x, start_y = -((cols * (size + spacing)) / 2), 200


def draw_square(x, y, s, color):        # I defined the square as function // x,y is position; s is the size
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.color(color)
    t.begin_fill()
    for _ in range(4):
        t.forward(s)
        t.right(90)
    t.end_fill()


for r in range(rows): #outer loop(y)
    ratio = r / (rows - 1)

    for c in range(cols): #inner loop(x)
        if random.random() > 0.1: # 10% chance to skip a square, which creates the gaps in the artwork
            x = start_x + (c * (size + spacing)) + random.uniform(-2, 2)# the random position of the squares, for the shaky look
            y = start_y - (r * (size + spacing)) + random.uniform(-2, 2)

            # Define the color gradient: transitioning from Red to Blue
            base_color = [1.0 - ratio, 0.1, ratio]
            #added the random color variance to each square
            final_color = [max(0, min(1, c + random.uniform(-0.1, 0.1))) for c in base_color]

            draw_square(x, y, size, tuple(final_color))

screen.update()  # show the picture now
screen.exitonclick()

